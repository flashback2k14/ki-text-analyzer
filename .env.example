# Zugangsdaten für den Basic-Auth-Schutz (Pflicht im Betrieb)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=bitte-aendern

# Nur für lokale Entwicklung: Basic Auth abschalten
# BASIC_AUTH_DISABLED=true

# Anthropic API (optional; ohne Key läuft nur die Regel-Analyse)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Port, unter dem docker compose die App veröffentlicht
APP_PORT=3000
