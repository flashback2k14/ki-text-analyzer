# Geheimnis zum Verschlüsseln der hinterlegten API-Keys (Pflicht). Erzeugen mit: openssl rand -base64 32
# Achtung: Wird das Secret geändert, sind alle gespeicherten API-Keys unlesbar und müssen neu eingetragen werden.
APP_SECRET=

# Einladungscode für die Registrierung. Ohne Wert ist die Registrierung gesperrt.
REGISTRATION_CODE=

# Verzeichnis für die SQLite-Datenbank (app.db). In Docker /app/data.
DATA_DIR=./data

# Nur für Betrieb ohne HTTPS (z. B. im LAN): Session-Cookie auch über http setzen
# SESSION_COOKIE_INSECURE=true

# Anthropic API (optional). Serverweiter Fallback-Key; jeder User kann im Konto einen eigenen Key hinterlegen.
ANTHROPIC_API_KEY=
# Server-Vorgabe für das Modell; jeder User kann im Konto ein anderes wählen.
ANTHROPIC_MODEL=claude-opus-5

# Wechselkurs USD je 1 EUR als Ausweichwert, falls der EZB-Tageskurs nicht abrufbar ist (optional, z. B. 1.08)
# USD_EUR_RATE=1.08

# Port, unter dem docker compose die App veröffentlicht
APP_PORT=3000
